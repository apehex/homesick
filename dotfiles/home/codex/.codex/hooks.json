{
  "description": "Isolate Codex shell commands and report cgroup/OOM outcomes.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 /home/avrana/.codex/hooks/oom_setup.py --hook --slice-name=codex-jobs.slice --slice-high=10G --slice-max=12G --pressure-limit=40% --pressure-duration=15s",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 /home/avrana/.codex/hooks/oom_guard.py --slice-name=codex-jobs.slice --job-max=7G --job-swap-max=256M --tasks-max=512",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 /home/avrana/.codex/hooks/oom_callback.py",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
