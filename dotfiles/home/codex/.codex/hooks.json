{
  "description": "Isolate Codex shell commands, preserve OOM evidence, clean failed scopes, and monitor surviving descendants.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$HOME/.codex/hooks/oom_setup.py\" --hook --config default",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$HOME/.codex/hooks/oom_guard.py\" --config default",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$HOME/.codex/hooks/oom_callback.py\" --config default --monitor-seconds 21600",
            "timeout": 5,
            "additionalContextLimit": 1000
          },
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$HOME/.codex/hooks/oom_monitor.py\" --config default --grace-seconds 2 --poll-seconds 5 --max-seconds 21600",
            "async": true,
            "timeout": 21630,
            "additionalContextLimit": 1000
          }
        ]
      }
    ]
  }
}
